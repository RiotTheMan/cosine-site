---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 80 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="var(--ocean)"
  stroke-width="1.25"
  stroke-linecap="round"
  class:list={['mx-auto block opacity-70', className]}
  aria-hidden="true"
>
  <circle cx="50" cy="50" r="15" />
  <circle cx="50" cy="35" r="15" />
  <circle cx="50" cy="65" r="15" />
  <circle cx="62.99" cy="42.5" r="15" />
  <circle cx="62.99" cy="57.5" r="15" />
  <circle cx="37.01" cy="42.5" r="15" />
  <circle cx="37.01" cy="57.5" r="15" />
</svg>
