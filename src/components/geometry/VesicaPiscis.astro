---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 80 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 70"
  fill="none"
  stroke="var(--ocean)"
  stroke-width="1.25"
  stroke-linecap="round"
  class:list={['mx-auto block opacity-70', className]}
  aria-hidden="true"
>
  <circle cx="35" cy="35" r="30" />
  <circle cx="65" cy="35" r="30" />
</svg>
