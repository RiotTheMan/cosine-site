---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 80 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="var(--ocean)"
  stroke-width="1.25"
  stroke-linecap="round"
  class:list={['mx-auto block opacity-70', className]}
  aria-hidden="true"
>
  <circle cx="50" cy="50" r="42" />
  <path d="
    M 8 50
    C 18.5 50, 18.5 8, 29 8
    C 39.5 8, 39.5 92, 50 92
    C 60.5 92, 60.5 8, 71 8
    C 81.5 8, 81.5 50, 92 50
  " />
</svg>
