---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 80 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 92"
  fill="none"
  stroke="var(--ocean)"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['mx-auto block opacity-70', className]}
  aria-hidden="true"
>
  <path d="M 50 8 A 30 30 0 0 1 75.98 53 A 30 30 0 0 1 24.02 53 A 30 30 0 0 1 50 8 Z" />
  <path d="M 24.02 53 A 30 30 0 0 1 50 8" />
  <path d="M 75.98 53 A 30 30 0 0 1 24.02 53" />
  <path d="M 50 8 A 30 30 0 0 1 75.98 53" />
</svg>
