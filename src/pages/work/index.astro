---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('caseStudies', (s) => !s.data.draft))
  .sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));
---
<Base title="Work — CoSine" description="Things I've built. Each one is a bet on a specific idea.">
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-10">
    <h1 class="font-display text-5xl tracking-tight">Work</h1>
    <p class="mt-6 text-lg measure" style="color: var(--ink-soft);">
      Things I've built. Each one is a bet on a specific idea.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-24">
    <ul class="divide-y" style="border-color: var(--rule);">
      {studies.map((s) => (
        <li class="py-8" style="border-color: var(--rule); border-top: 1px solid var(--rule);">
          <a href={`/work/${s.data.slug}`} class="block">
            <p class="mono text-xs" style="color: var(--ink-soft);">
              {s.data.status} · {s.data.period}
            </p>
            <h2 class="font-display text-2xl mt-1">{s.data.title}</h2>
            <p class="mt-2 measure" style="color: var(--ink-soft);">{s.data.thesis}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
