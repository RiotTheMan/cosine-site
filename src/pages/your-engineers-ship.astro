---
import Base from '../layouts/Base.astro';
import Triquetra from '../components/geometry/Triquetra.astro';

const deliverables = [
  { name: 'FDE training',         desc: "Forward-deployed engineering as a discipline. Your seniors learn to work next to the model, not around it." },
  { name: 'A knowledge store',    desc: 'Deployable, scalable, queryable by both humans and LLMs. Procedures, decisions, institutional lore — not buried in Slack.' },
  { name: 'Approved patterns',    desc: "Captured from your lead engineers and architects. The model generates from these — output stays on-pattern, deterministically." },
  { name: 'Review-load relief',   desc: 'Senior time is the bottleneck. We move pattern enforcement upstream into the harness so reviewers approve, they don\'t debug.' },
];
---
<Base title="Your engineers ship — CoSine" description="FDE training for your team, a deployable knowledge store, and the approved-pattern library that lets the model generate deterministically.">
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-10">
    <p class="mono text-xs uppercase tracking-widest mb-6" style="color: var(--ink-soft);">§03 · For engineering teams</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-[1.05] tracking-tight">
      Make your engineers ship AI-assisted code <span class="fade-green">that holds</span>.
    </h1>
    <p class="mt-8 text-lg measure" style="color: var(--ink-soft);">
      Your team is shipping faster than you can review. The patterns drift. The tech debt accumulates in a shape you can feel but can't name. Senior time is the bottleneck — every prompt is a tax on it.
    </p>
    <p class="mt-6 text-lg measure" style="color: var(--ink-soft);">
      We move the discipline upstream. Pattern enforcement, knowledge retrieval, and review-relevant context — encoded in the harness, applied at the moment of generation. The same memory infrastructure running in production at a tech-driven bank, adapted to your team.
    </p>
  </section>

  <hr class="max-w-3xl" style="border-top: 1px solid var(--rule); margin: 2rem auto 0;" />

  <section class="max-w-3xl mx-auto px-6 py-20">
    <p class="mono text-xs uppercase tracking-widest mb-8" style="color: var(--ink-soft);">What you get</p>
    <ol class="border-t" style="border-color: var(--rule);">
      {deliverables.map((d, i) => (
        <li class="border-b py-7 grid grid-cols-12 gap-4 items-baseline" style="border-color: var(--rule);">
          <span class="col-span-2 sm:col-span-1 mono text-xs" style="color: var(--ink-soft);">0{i + 1}</span>
          <div class="col-span-10 sm:col-span-4">
            <h3 class="font-display text-xl tracking-tight">{d.name}</h3>
          </div>
          <p class="col-span-12 sm:col-span-7 text-sm leading-relaxed" style="color: var(--ink-soft);">{d.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">How it works</h2>
    <p>
      A two- to four-week pilot with one team. We sit with the leads and architects, capture the patterns that already exist in their heads, and stand up the knowledge store + harness around them. Workshops alongside. The pilot ships a real feature on the new rails — then you decide what to roll out.
    </p>
  </section>

  <div class="flex justify-center py-12">
    <Triquetra size={88} />
  </div>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="grid sm:grid-cols-2 gap-8 border-t border-b py-10" style="border-color: var(--rule);">
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">← Simpler version</p>
        <a href="/run-your-business" class="font-display text-xl tracking-tight">Run your business →</a>
      </div>
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">Outgrowing this? →</p>
        <a href="/unlock-your-stack" class="font-display text-xl tracking-tight">Unlock your codebase + data →</a>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">Talk</h2>
    <p class="mb-6">Pilot with one team. Decide from there.</p>
    <p class="mono">
      <a href="mailto:hello@cosinehq.co.za">hello@cosinehq.co.za</a>
      <span class="mx-3" style="color: var(--ink-soft);">·</span>
      <a href="/#talk">Use the form →</a>
    </p>
  </section>
</Base>
