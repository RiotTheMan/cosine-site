---
import Base from '../layouts/Base.astro';
import GoldenSpiral from '../components/geometry/GoldenSpiral.astro';

const deliverables = [
  { name: 'A capable harness',     desc: 'Hooks, gates, and a memory tuned to your domain — booking flows, inventory, billing, integrations.' },
  { name: 'Deployable software',   desc: 'A real artefact: built, deployed, observable. Not a vibe-coded prototype with a hosting bill.' },
  { name: 'Maintenance you grasp', desc: 'The codebase, the deploy story, the rollback story — readable. You are the principal user, not a hostage.' },
  { name: 'A path to extend',      desc: 'When the business needs the next thing, the next thing fits. No rewrite required.' },
];
---
<Base title="Run your business — CoSine" description="Deployable, maintainable software for solo business owners. A capable harness, a real artefact, and the literacy to keep it running.">
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-10">
    <p class="mono text-xs uppercase tracking-widest mb-6" style="color: var(--ink-soft);">§02 · For solo business owners</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-[1.05] tracking-tight">
      Run your business on software <span class="fade-green">you trust</span>.
    </h1>
    <p class="mt-8 text-lg measure" style="color: var(--ink-soft);">
      You don't need a dev team. You don't need to become a developer. You need a working system, a way to extend it, and confidence that the next change won't break the last one.
    </p>
    <p class="mt-6 text-lg measure" style="color: var(--ink-soft);">
      A capable harness covers more of the work — billing, integrations, customer flows. We build the thing, deploy it, and equip you to keep it alive without us in the loop.
    </p>
  </section>

  <hr class="max-w-3xl" style="border-top: 1px solid var(--rule); margin: 2rem auto 0;" />

  <section class="max-w-3xl mx-auto px-6 py-20">
    <p class="mono text-xs uppercase tracking-widest mb-8" style="color: var(--ink-soft);">What you get</p>
    <ol class="border-t" style="border-color: var(--rule);">
      {deliverables.map((d, i) => (
        <li class="border-b py-7 grid grid-cols-12 gap-4 items-baseline" style="border-color: var(--rule);">
          <span class="col-span-2 sm:col-span-1 mono text-xs" style="color: var(--ink-soft);">0{i + 1}</span>
          <div class="col-span-10 sm:col-span-4">
            <h3 class="font-display text-xl tracking-tight">{d.name}</h3>
          </div>
          <p class="col-span-12 sm:col-span-7 text-sm leading-relaxed" style="color: var(--ink-soft);">{d.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">How it works</h2>
    <p>
      One- or two-week discovery, fixed price — to understand the business, the workflows, the edges. Then a fixed-scope engagement that ships the system and teaches you how to keep it shipping. No retainer, no hourly. You leave the principal operator of your own software.
    </p>
  </section>

  <div class="flex justify-center py-12">
    <GoldenSpiral size={96} />
  </div>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="grid sm:grid-cols-2 gap-8 border-t border-b py-10" style="border-color: var(--rule);">
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">← Simpler version</p>
        <a href="/build-the-thing" class="font-display text-xl tracking-tight">Build the thing →</a>
      </div>
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">Outgrowing this? →</p>
        <a href="/your-engineers-ship" class="font-display text-xl tracking-tight">Make your engineers ship →</a>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">Talk</h2>
    <p class="mb-6">Tell me what your business actually does. The rest follows from there.</p>
    <p class="mono">
      <a href="mailto:hello@cosinehq.co.za">hello@cosinehq.co.za</a>
      <span class="mx-3" style="color: var(--ink-soft);">·</span>
      <a href="/#talk">Use the form →</a>
    </p>
  </section>
</Base>
