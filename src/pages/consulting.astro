---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import GoldenSpiral from '../components/geometry/GoldenSpiral.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Consulting — CoSine" description="Software consulting for people who want to take control of the software they depend on.">
  <section class="max-w-2xl mx-auto px-6 pt-20 pb-12">
    <h1 class="font-display text-5xl tracking-tight">Consulting</h1>
    <p class="mt-6 text-lg measure" style="color: var(--ink-soft);">
      Software consulting for people who want to take control of the software
      they depend on. AI is part of the toolkit. Discipline is the practice.
      Three services, one premise: ship something reliable, ship something
      safe, ship something you understand.
    </p>
  </section>

  <section class="max-w-2xl mx-auto px-6 py-8">
    <h2 class="font-display text-2xl mb-6">What I help with</h2>
    <div class="space-y-10">
      {services.map((s) => (
        <div>
          <h3 class="font-display text-xl">{s.data.title}</h3>
          <p class="mt-2 measure" style="color: var(--ink-soft);">{s.data.summary}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="flex justify-center py-12">
    <GoldenSpiral size={96} />
  </div>

  <section class="max-w-2xl mx-auto px-6 py-12">
    <h2 class="font-display text-2xl mb-4">How I work</h2>
    <p class="measure">
      A short discovery — one or two weeks, fixed price — to understand where
      you are, what you need, and what success looks like. Then a fixed-scope
      engagement that ships something — and teaches you how to keep shipping.
      I'm a self-taught developer; what I teach is how to teach yourself.
      No retainer, no hourly. You leave knowing more, with a system that holds.
    </p>
  </section>

  <section class="max-w-2xl mx-auto px-6 py-12">
    <h2 class="font-display text-2xl mb-4">Talk</h2>
    <p class="measure mb-6">
      Email is fine. If a 15-minute intro is faster, book one.
    </p>
    <p class="mono">
      <a href="mailto:hello@cosinehq.co.za">hello@cosinehq.co.za</a>
      <span class="mx-3" style="color: var(--ink-soft);">·</span>
      <a href="/book">Book 15 min →</a>
    </p>
  </section>
</Base>
