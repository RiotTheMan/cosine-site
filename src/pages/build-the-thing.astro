---
import Base from '../layouts/Base.astro';
import SeedOfLife from '../components/geometry/SeedOfLife.astro';

const deliverables = [
  { name: 'A clarified goal',     desc: 'A short guided discovery — me, you, and the model — until what you want is sayable.' },
  { name: 'A personal harness',   desc: 'Hooks, gates, and a memory that steer the model toward what you actually meant.' },
  { name: 'The thing, shipped',   desc: 'Portfolio site, automation, research artefact — built so you can keep building it.' },
  { name: 'The literacy to extend', desc: 'You leave understanding the system. No vendor lock-in to me.' },
];
---
<Base title="Build the thing — CoSine" description="A clarified goal, a personal harness, and the literacy to keep shipping. For individuals who want to take control of the software they depend on.">
  <section class="max-w-3xl mx-auto px-6 pt-20 pb-10">
    <p class="mono text-xs uppercase tracking-widest mb-6" style="color: var(--ink-soft);">§01 · For individuals</p>
    <h1 class="font-display text-5xl sm:text-6xl leading-[1.05] tracking-tight">
      Build the thing you've been trying to <span class="fade-green">vibe-code</span>.
    </h1>
    <p class="mt-8 text-lg measure" style="color: var(--ink-soft);">
      Portfolio sites, personal automation, research projects. The thing where you have the idea, the model produces output, and somewhere between "this is amazing" and "I can't make it work" you stall.
    </p>
    <p class="mt-6 text-lg measure" style="color: var(--ink-soft);">
      We fix the gap. A short, guided discovery names what you actually want; a small harness encodes the discipline the model needs to deliver it; what gets shipped is yours to extend.
    </p>
  </section>

  <hr class="max-w-3xl" style="border-top: 1px solid var(--rule); margin: 2rem auto 0;" />

  <section class="max-w-3xl mx-auto px-6 py-20">
    <p class="mono text-xs uppercase tracking-widest mb-8" style="color: var(--ink-soft);">What you get</p>
    <ol class="border-t" style="border-color: var(--rule);">
      {deliverables.map((d, i) => (
        <li class="border-b py-7 grid grid-cols-12 gap-4 items-baseline" style="border-color: var(--rule);">
          <span class="col-span-2 sm:col-span-1 mono text-xs" style="color: var(--ink-soft);">0{i + 1}</span>
          <div class="col-span-10 sm:col-span-4">
            <h3 class="font-display text-xl tracking-tight">{d.name}</h3>
          </div>
          <p class="col-span-12 sm:col-span-7 text-sm leading-relaxed" style="color: var(--ink-soft);">{d.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">How it works</h2>
    <p>
      A one-week discovery, fixed price. We sit with the model, surface what you actually want, and write it down. Then a short engagement to build the thing and equip your harness with the precedents that keep it on rails. You leave with both — the artefact and the literacy.
    </p>
  </section>

  <div class="flex justify-center py-12">
    <SeedOfLife size={88} />
  </div>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="grid sm:grid-cols-2 gap-8 border-t border-b py-10" style="border-color: var(--rule);">
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">← Simpler version</p>
        <p class="text-sm" style="color: var(--ink-soft);">This is the entry tier.</p>
      </div>
      <div>
        <p class="mono text-xs uppercase tracking-widest mb-3" style="color: var(--ink-soft);">Outgrowing this? →</p>
        <a href="/run-your-business" class="font-display text-xl tracking-tight">Run your business on software you trust →</a>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16 measure">
    <h2 class="font-display text-2xl tracking-tight mb-4">Talk</h2>
    <p class="mb-6">A sentence is enough to start.</p>
    <p class="mono">
      <a href="mailto:hello@cosinehq.co.za">hello@cosinehq.co.za</a>
      <span class="mx-3" style="color: var(--ink-soft);">·</span>
      <a href="/#talk">Use the form →</a>
    </p>
  </section>
</Base>
